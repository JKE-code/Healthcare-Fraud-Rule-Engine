<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FraudGuard Pay"
            android:textColor="#38BDF8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select a Customer Profile to simulate transaction behaviour:"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Backend Host Config -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Backend API URL"
            android:textColorHint="#94A3B8"
            app:boxStrokeColor="#38BDF8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBackendUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="http://10.0.2.2:8000"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="4 Customer Baselines"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Profile 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCust1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rohan Sharma (Student)"
                    android:textColor="#38BDF8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ID: CUST-1001 • Channel: UPI • Avg: ₹650 (₹50-₹2,500)\nKnown: Pune, Mumbai | DEV-ROHAN-PIXEL\nRisk Tolerance: LOW"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSelectCust1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#0284C7"
                    android:text="Login as Rohan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCust2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Priya Verma (Corporate Exec)"
                    android:textColor="#34D399"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ID: CUST-1002 • Channel: CARD • Avg: ₹42,000 (₹1K-₹1.5L)\nKnown: Mumbai, Bengaluru, Delhi | DEV-PRIYA-S23\nRisk Tolerance: HIGH"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSelectCust2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#059669"
                    android:text="Login as Priya"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCust3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amit Patel (Retail Merchant)"
                    android:textColor="#FBBF24"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ID: CUST-1003 • Channel: UPI • Avg: ₹7,500 (₹500-₹25,000)\nKnown: Ahmedabad, Surat, Delhi | DEV-AMIT-ONEPLUS\nRisk Tolerance: MEDIUM"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSelectCust3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#D97706"
                    android:text="Login as Amit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile 4 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCust4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sneha Reddy (Tech Freelancer)"
                    android:textColor="#A78BFA"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ID: CUST-1004 • Channel: DEBIT • Avg: ₹3,400 (₹200-₹12,000)\nKnown: Hyderabad, Bengaluru | DEV-SNEHA-MOTO\nRisk Tolerance: LOW"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSelectCust4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#7C3AED"
                    android:text="Login as Sneha"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
