# Database Configuration
# Leave blank for zero-configuration local SQLite, or uncomment for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/fraud_rules_db
DATABASE_URL=sqlite:///./backend/fraud_rules.db

# AWS SES & SNS Alerting (Optional: sandbox mock mode activates automatically if omitted)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_SENDER=alerts@acentra-fraud.internal
AWS_SES_RECIPIENT=secops-triage@acentra-fraud.internal
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:fraud-high-risk-alerts
AWS_ALERT_THRESHOLD=0.70
